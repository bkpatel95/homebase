# The Daily Bhavi — environment variables for deploy.
# Copy to `deploy/.env` on the prod box (chmod 600 — gitignored). Anything
# left blank uses the default in docker-compose.yml.

# ─── Secrets — required for the corresponding connector features ────────────
ANTHROPIC_API_KEY=
PLEX_TOKEN=
OVERSEERR_API_KEY=
OURA_TOKEN=

# Google OAuth client for Gmail + Google Calendar connectors. Create both
# at https://console.cloud.google.com (see docs/google-oauth-setup.md for
# the full walkthrough). Without these, both connectors render unavailable
# and /api/auth/google/login returns 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default redirect URI matches the prod hostname. Override if needed.
# GOOGLE_REDIRECT_URI=https://homebase.lebcp.com/api/auth/google/callback

# ─── Auth ──────────────────────────────────────────────────────────────────
HOMEBASE_REQUIRE_AUTH=true
HOMEBASE_ALLOWED_EMAILS=bhavipatel141@gmail.com

# ─── Hosts (override only if changing from compose defaults) ───────────────
# PLEX_URL=http://host.containers.internal:32400
# OVERSEERR_URL=http://host.containers.internal:5055
# MARKETS_EXTRA=

# ─── Observability ─────────────────────────────────────────────────────────
# SENTRY_DSN — when set, the backend reports exceptions and a 0.1-sampled
# trace stream to Sentry. Leave blank to disable; the app runs fine without it.
# Get a DSN from sentry.io (create project → Settings → Client Keys (DSN))
# or your self-hosted Sentry instance.
SENTRY_DSN=

# ENV — used as the Sentry `environment` tag and to pick the default log
# format (json in production, text otherwise). Examples: production, staging, dev.
ENV=production

# LOG_FORMAT — "json" or "text". Leave blank to auto-pick from ENV.
LOG_FORMAT=

# LOG_LEVEL — DEBUG / INFO / WARNING / ERROR. Default INFO.
LOG_LEVEL=INFO
