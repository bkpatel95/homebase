# homebase — environment template
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored. Never commit a populated copy.
#
# In dev (docker-compose.dev.yml) only ANTHROPIC_API_KEY is strictly
# required to start the app — everything else either has a sensible default
# or gracefully degrades to "connector unavailable" in the UI.
#
# In prod the same .env lives at ~/homebase/deploy/.env (chmod 600).

# ─── Required ──────────────────────────────────────────────────────────────

# Anthropic API key for the chat backend. Without this the app refuses to
# start (see backend/config.py validate_env).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional integration secrets ──────────────────────────────────────────
# Each missing token logs a warning at startup. The corresponding widget
# will render "not configured" in the UI but the app still runs.

# Oura Ring personal access token. If unset, the Oura connector falls back
# to reading OURA_SUMMARY (a daily-summary.json file rsync'd from elsewhere).
# Get one at: https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=

# Plex X-Plex-Token for the media widget's "recently added" list.
# Find under: Plex → Account → Authorized Devices → Show Token
PLEX_TOKEN=

# Overseerr API key for the media widget's "pending requests" list.
# Generate under: Overseerr → Settings → General
OVERSEERR_API_KEY=

# Weather (Open-Meteo) — no API key required. Defaults point at Park City, UT.
# WEATHER_LAT=40.6461
# WEATHER_LON=-111.498
# WEATHER_LABEL=Park City, UT
# WEATHER_UNITS=fahrenheit       # fahrenheit | celsius

# Apple Reminders — only meaningful on a macOS host. The connector tries
# osascript first (needs Reminders TCC permission granted to the process
# running the dashboard); if that fails, it falls back to a JSON file
# rsync'd from a host-side sync job. Set REMINDERS_MODE=file to skip the
# osascript probe entirely.
# REMINDERS_MODE=auto              # auto | osascript | file
# REMINDERS_PATH=/data/reminders/today.json

# Gmail — OAuth 2.0 client credentials downloaded from Google Cloud Console.
# Run /api/gmail/auth once to bootstrap the token file.
# GMAIL_CREDENTIALS_PATH=/data/gmail/credentials.json
# GMAIL_TOKEN_PATH=/data/gmail/token.json
# GMAIL_LABELS=UNREAD
# GMAIL_QUERY=
# GMAIL_HOURS=24
# GMAIL_MAX_RESULTS=20
# Override the OAuth redirect URI when the app sits behind nginx/cloudflared
# and the URL Google calls back to differs from what FastAPI sees internally.
# GMAIL_REDIRECT_URI=https://homebase.lebcp.com/api/gmail/auth/callback

# ─── External service URLs (defaults are fine for prod) ────────────────────

# Plex base URL. Prod uses host.containers.internal (the host machine);
# in dev compose this is overridden to a non-resolving name so the connector
# fails fast rather than hanging.
PLEX_URL=http://host.containers.internal:32400

# Overseerr base URL. Same pattern as PLEX_URL.
OVERSEERR_URL=http://host.containers.internal:5055

# Prometheus query API. In prod, daily-bhavi joins the monitoring-net
# created by podman-server's monitoring stack and reaches it as
# http://prometheus:9090. Override here only if you're running a local one.
PROMETHEUS_URL=http://prometheus:9090

# ─── Auth (Cloudflare Access guard) ────────────────────────────────────────

# Comma-separated list of emails the cloudflare_access_guard middleware
# accepts. The middleware reads cf-access-authenticated-user-email from the
# request headers (set by Cloudflare Access in front of the tunnel).
ALLOWED_EMAILS=bhavipatel141@gmail.com

# Set to false in dev to bypass the auth check entirely. docker-compose.dev.yml
# already forces this off — only relevant if you're running uvicorn outside
# docker and want to test against the real header behavior.
REQUIRE_AUTH=true

# ─── Locale / timezone ─────────────────────────────────────────────────────

# Drives the morning/midday/evening edition mood and date formatting.
TZ=America/New_York

# ─── Observability (optional) ──────────────────────────────────────────────

# Drives default log format selection (json in prod, text otherwise) and
# is reported as the Sentry environment tag. See backend/logging_config.py
# and backend/app.py for how these are read.
ENV=development

# Override log format explicitly. One of: json, text.
# LOG_FORMAT=text

# Override log level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Sentry DSN. When unset, the SDK is not initialized and the app runs
# without it. Set in prod to forward exceptions.
# SENTRY_DSN=

# ─── Connector tuning (rarely set) ─────────────────────────────────────────

# Per-request HTTP timeouts. Defaults shown; only override if you're
# debugging a slow connector.
# OURA_TIMEOUT=4.0
# MEDIA_TIMEOUT=4.0
# PROMETHEUS_TIMEOUT=4.0
# MARKETS_TIMEOUT=5.0
# WEATHER_TIMEOUT=4.0
# GMAIL_TIMEOUT=6.0
# REMINDERS_TIMEOUT=6.0

# Extra Stooq tickers to add to the markets widget (comma-separated).
# Example: ^FTSE,^VIX
# MARKETS_EXTRA=

# ─── File-backed connector paths (set automatically in compose) ────────────
# These are baked into both deploy/docker-compose.yml and
# docker-compose.dev.yml — you usually don't need to set them in .env.
# Listed here so the full set is discoverable in one place.
#
# LAYOUT_PATH=/data/layout.json
# SOURCES_PATH=/data/sources.json
# PROD_HEALTH_JSON=/data/health-data/prod-health.json
# OURA_SUMMARY=/data/health-data/daily-summary.json
# CALENDAR_EVENTS=/data/calendar/today.json
# RECIPE_DIR=/data/recipes
# REMINDERS_PATH=/data/reminders/today.json
# GMAIL_CREDENTIALS_PATH=/data/gmail/credentials.json
# GMAIL_TOKEN_PATH=/data/gmail/token.json

# ─── Future: chat history persistence (Phase 4) ────────────────────────────
# docker-compose.dev.yml stands up a Postgres container and exposes this
# var, but the current code does not read it (sessions are in-memory —
# see backend/chat/session.py). Reserved for future use.
#
# DATABASE_URL=postgresql://homebase:homebase@postgres:5432/homebase_chat
