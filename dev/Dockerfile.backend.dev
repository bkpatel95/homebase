# Backend dev image — installs deps once at build time so subsequent
# container starts are fast. The actual source code is mounted in via
# docker-compose volumes, and uvicorn --reload watches for changes.

FROM docker.io/library/python:3.12-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

EXPOSE 8000

CMD ["uvicorn", "backend.app:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--reload", "--reload-dir", "/app/backend"]
